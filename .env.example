# `uv run techletter settings example`로 생성한 골격에 로컬 개발용 기본값을
# 채운 것이다. 최신 목록이 필요하면 그 명령을 다시 돌린다(코드가 진실).
# 시크릿은 아래 예시값을 그대로 쓰지 말 것 — 전부 로컬 전용 더미다.

# 서비스
SERVICE_NAME=techletter
LOG_LEVEL=INFO
API_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# MongoDB (docker/compose.dev.yml 기본값)
MONGO_URI=mongodb://root:devpassword@localhost:27017/techletter?authSource=admin
MONGO_DB_NAME=techletter
SERVER_SELECTION_TIMEOUT_MS=5000
CONNECT_TIMEOUT_MS=5000
SOCKET_TIMEOUT_MS=30000

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=tech_letter_posts

# 인증 (Google OAuth · JWT)
JWT_SECRET=dev-only-secret-change-me
JWT_ISSUER=tech-letter
JWT_TTL_SECONDS=86400
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback
AUTH_LOGIN_SUCCESS_REDIRECT_URL=http://localhost:5173/login/success
LOGIN_SESSION_TTL_SECONDS=60
OAUTH_STATE_TTL_SECONDS=300
AUTH_COOKIE_SECURE=False

# Gemini/OpenRouter 키는 역할(요약/임베딩/챗봇)별로 나뉘어 있지 않다 — provider
# 하나당 계정 하나뿐이라 아래 두 값을 모든 Gemini/OpenRouter 역할이 같이 쓴다.
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxx
OPENROUTER_API_KEY=xxxxxxxxxxxxxxxxxxx

# 요약 워커 LLM (Gemini 1순위)
SUMMARY_WORKER_LLM_PROVIDER=google
SUMMARY_WORKER_LLM_MODEL_NAME=gemini-3-flash-preview
SUMMARY_WORKER_LLM_BASE_URL=
SUMMARY_WORKER_LLM_TEMPERATURE=0.3
SUMMARY_WORKER_LLM_MAX_RETRIES=0
SUMMARY_WORKER_LLM_TIMEOUT_SECONDS=120

# 임베딩 워커 LLM (Gemini 고정)
EMBEDDING_WORKER_LLM_PROVIDER=google
EMBEDDING_WORKER_LLM_MODEL_NAME=gemini-embedding-001
EMBEDDING_WORKER_LLM_BASE_URL=
EMBEDDING_WORKER_LLM_TEMPERATURE=0.3
EMBEDDING_WORKER_LLM_MAX_RETRIES=0
EMBEDDING_WORKER_LLM_TIMEOUT_SECONDS=120

# 챗봇 LLM (OpenRouter 1순위)
CHATBOT_LLM_PROVIDER=openrouter
CHATBOT_LLM_MODEL_NAME=
CHATBOT_LLM_BASE_URL=
CHATBOT_LLM_TEMPERATURE=0.7
CHATBOT_LLM_MAX_RETRIES=0
CHATBOT_LLM_TIMEOUT_SECONDS=120

# 챗봇 임베딩 (Gemini 고정, 임베딩 워커와 같은 모델이어야 벡터 공간이 맞는다)
CHATBOT_EMBEDDING_PROVIDER=google
CHATBOT_EMBEDDING_MODEL_NAME=gemini-embedding-001
CHATBOT_EMBEDDING_BASE_URL=
CHATBOT_EMBEDDING_TEMPERATURE=0.3
CHATBOT_EMBEDDING_MAX_RETRIES=0
CHATBOT_EMBEDDING_TIMEOUT_SECONDS=120

# LLM 모델 라우터 — 무료 모델 헬스체크 기록이 없으면 정적 폴백만 쓴다
SCOUTER_TIMEOUT_SECONDS=20.0
SCOUTER_CACHE_TTL_SECONDS=600
SCOUTER_SCAN_INTERVAL_HOURS=1.0
SCOUTER_SCAN_MAX_RETRIES=2
SCOUTER_SCAN_CONCURRENCY=2
SCOUTER_SCAN_REQUEST_DELAY_SECONDS=0.3
SCOUTER_SCAN_PROMPT=Respond with the exact text: OK
SCOUTER_CHECK_RETENTION_DAYS=3
MIN_UPTIME_24H=90.0
MAX_MODEL_ATTEMPTS=3
LLM_MIN_SUCCESS_RATE=0.6
MIN_ATTEMPTS_FOR_DEMOTION=10
LLM_QUOTA_RESET_UTC_HOUR=7
SUMMARY_DAILY_BUDGET=20
SUMMARY_MODEL_PREFERENCE=
CHAT_MODEL_PREFERENCE=
CHAT_PLANNER_MODEL_PREFERENCE=
LLM_STATIC_FALLBACK_MODELS=
CHAT_GEMINI_FALLBACK=True

# 잡 큐 (ADR-0004)
JOB_POLL_INTERVAL_SECONDS=2.0
IDLE_BACKOFF_SECONDS=10.0
JOB_LOCK_TIMEOUT_MINUTES=30
SUMMARY_LOCK_TIMEOUT_MINUTES=60
JOB_MAX_ATTEMPT=5
JOB_BACKOFF_MINUTES=5,30,120,480,1440
DONE_TTL_DAYS=14
QUOTA_MAX_WAIT_HOURS=30

# RSS 수집
INTERVAL_SECONDS=1800
CONTENT_BLOG_FETCH_BATCH_SIZE=10
REQUEST_TIMEOUT_SECONDS=30
RSS_TLS_INSECURE_HOSTS=
AUTO_DISABLE_AFTER_FAILURES=48

# 요약 파이프라인
RENDERER_STRATEGY=playwright
SCRAPERAPI_KEY=
SUMMARY_MAX_INPUT_CHARS=12000
MAX_RENDER_ATTEMPTS=3
RENDER_TIMEOUT_SECONDS=30
MAX_THUMBNAIL_CANDIDATES=10
SUMMARY_TARGET_CHARS=200
SUMMARY_TOLERANCE_CHARS=20
MAX_TAGS=7

# 임베딩 파이프라인
EMBEDDING_WORKER_CHUNK_SIZE=1000
EMBEDDING_WORKER_CHUNK_OVERLAP=200
EMBED_BATCH_SIZE=64
MAX_CHUNKS_PER_POST=200

# 챗봇
CHATBOT_RAG_TOP_K=5
CHATBOT_RAG_SCORE_THRESHOLD=0.5
HISTORY_LIMIT=60
MEMORY_RECENT_MESSAGES=8
MEMORY_MAX_MESSAGE_CHARS=1200
MEMORY_MAX_SUMMARY_CHARS=1800
CHAT_CONTEXT_COMPRESSION_MIN_MESSAGES=12
CHAT_CONTEXT_COMPRESSION_BATCH_SIZE=6
CREDITS_PER_MESSAGE=1
DAILY_CREDIT_GRANT=10
